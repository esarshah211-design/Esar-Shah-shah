rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'esarshah211@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Menu Items - Public can view, Admin can manage
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories - Public can view, Admin can manage
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders - Customers can place orders, Admin can view and update
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if incoming().customerName is string &&
                       incoming().customerName.size() >= 2 && incoming().customerName.size() <= 100 &&
                       incoming().phone is string &&
                       incoming().phone.size() >= 7 && incoming().phone.size() <= 25 &&
                       incoming().orderType in ['pickup', 'delivery'] &&
                       incoming().totalAmount is number &&
                       incoming().totalAmount >= 0 &&
                       incoming().status in ['New', 'Confirmed', 'Preparing', 'Ready', 'Completed', 'Cancelled'];
      allow update, delete: if isAdmin();
    }

    // Customer Enquiries - Public can submit, Admin can view and manage
    match /enquiries/{enquiryId} {
      allow read: if isAdmin();
      allow create: if incoming().name is string &&
                       incoming().name.size() >= 2 && incoming().name.size() <= 100 &&
                       incoming().message is string &&
                       incoming().message.size() >= 3 && incoming().message.size() <= 1000;
      allow update, delete: if isAdmin();
    }

    // Food Gallery - Public can view, Admin can manage
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Website Settings - Public can view, Admin can manage
    match /websiteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Reviews - Public can view approved reviews, anyone can submit, Admin can manage
    match /reviews/{reviewId} {
      allow read: if resource.data.isApproved == true || isAdmin();
      allow create: if incoming().customerName is string &&
                       incoming().customerName.size() >= 2 && incoming().customerName.size() <= 100 &&
                       incoming().rating is number &&
                       incoming().rating >= 1 && incoming().rating <= 5 &&
                       incoming().reviewText is string &&
                       incoming().reviewText.size() <= 500;
      allow update, delete: if isAdmin();
    }
  }
}
